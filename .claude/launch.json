{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--port=8000"
      ],
      "port": 8000
    },
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "reverb",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "reverb:start",
        "--port=8080"
      ],
      "port": 8080
    }
  ]
}